PORT=8080
NODE_ENV=development
# Provider switch: gemini (Gemini API, in-process) or bedrock (AWS Bedrock, in-process).
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
FALLBACK_GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.1-flash
MAX_RETRIES=3
THINKING_BUDGET=0
# Bedrock waterfall (LiteLLM format, inference-profile form).
BEDROCK_MODELS=bedrock/us.amazon.nova-lite-v1:0
AWS_REGION=us-east-1
# AWS auth: EITHER IAM keys (covers Bedrock + Transcribe) ...
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# ... OR a Bedrock bearer key (Bedrock only).
# AWS_BEARER_TOKEN_BEDROCK=ABSK...
MAIN_BACKEND_HTTP_URL=http://localhost:3000
MAIN_BACKEND_SOCKET_URL=http://localhost:3000
# Shared bearer secret for socket + HTTP auth against the backend.
# MUST match the backend's AGENT_SERVICE_SECRET. Generate with: openssl rand -hex 32
AGENT_SECRET=replace-with-a-long-random-agent-secret
MAX_TURNS_PER_INSTRUCTION=15
REASONING_TIMEOUT_MS=120000
# Text-to-speech backend for the voice call:
#   piper (default) local ONNX neural TTS — offline, no vendor endpoint, ~5.8x realtime
#   edge            Microsoft Edge read-aloud (edge-tts) — better fidelity, no SLA
# Whichever is primary, the other is used automatically if it yields no audio.
TTS_BACKEND=piper
# Piper voice name + where the .onnx model lives. Browse voices at
# https://huggingface.co/rhasspy/piper-voices — "medium" is ~60MB.
PIPER_VOICE=en_US-amy-medium
# PIPER_VOICE_DIR=./voices
# Auto-fetch the model on first use. Handy locally; the Docker image bakes the
# model in at build time and sets this to false so prod never hits the network.
PIPER_AUTO_DOWNLOAD=true
# Voice used only by the edge backend.
TTS_VOICE=en-US-AriaNeural
# Speech-to-text backend, independent of LLM_PROVIDER:
#   auto   (default) gemini audio when LLM_PROVIDER=gemini, else local whisper
#   gemini  Gemini audio understanding — needs GEMINI_API_KEY, no heavy deps
#   local   faster-whisper on CPU — needs requirements/optional/whisper.txt
#   aws     Amazon Transcribe streaming — needs optional/transcribe.txt + IAM keys
STT_BACKEND=auto
STT_MODEL=base
STT_LANGUAGE=en
# Lesson memory (Firestore). Leave disabled for zero-setup local dev.
FIRESTORE_ENABLED=false
FIRESTORE_PROJECT_ID=your-gcp-project-id
# Named database ID — "(default)" unless you created a custom one.
FIRESTORE_DATABASE_ID=(default)
# Service-account auth: EITHER a key-file path (standard) ...
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# ... OR inline JSON (good for Fly secrets). Never commit either.
# FIRESTORE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Cursor animation speed multiplier. 1.0 = default "human-speed" pen timing.
# 2.0 makes every glide/trace/hold twice as fast (halves animation latency);
# 0.5 slows it down. Allowed range 0.25 - 8.0.
# CURSOR_SPEED=1.0
