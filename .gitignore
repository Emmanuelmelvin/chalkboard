# Dependencies
node_modules/
.pnpm-store/
.venv/
venv/
__pycache__/
*.pyc

# Environment and secrets
.env
.env.*
!.env.example
!.env.*.example
# GCP service-account key files must never be committed
*service-account*.json
*service_account*.json
*-key.json

# Build output and generated coverage
dist/
build/
coverage/
*.tsbuildinfo

# Logs and local runtime files
*.log
backend/.data/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed

# Caches and temporary files
.cache/
.turbo/
.vite/
*.local

# Downloaded model weights — fetched by the agent-service at first run and
# baked into the Docker image at build time. Never commit (60MB+ each).
agent-service/voices/
*.onnx

# Editor and operating-system files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.sw?
