# agent-brain environment. Never commit real secrets.
BRAIN_PORT=8081
# Must match agent-service AGENT_SECRET (both directions use it).
AGENT_SECRET=chalkboard_agent_internal_secret_key_2026
# Node agent-service base URL (tool callbacks go here).
NODE_URL=http://localhost:8080
# Comma-separated Bedrock model fallback list (LiteLLM format).
BEDROCK_MODELS=bedrock/anthropic.claude-3-5-haiku-20241022-v1:0
# AWS auth: EITHER IAM keys (covers Bedrock + Transcribe) ...
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# ... OR a Bedrock bearer key (Bedrock only; Transcribe still needs IAM keys).
# AWS_BEARER_TOKEN_BEDROCK=ABSK...
# Per-run cap (Node enforces REASONING_TIMEOUT_MS on top).
BRAIN_RUN_TIMEOUT_S=110
# Path to SYSTEM_INFO.md (agent instruction).
BRAIN_SYSTEM_INFO=../agent-service/SYSTEM_INFO.md
