PROCESS_TYPE=server
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
PG_POOL_SIZE=10
# Comma-separated browser origins allowed in production. Development also allows private LAN origins.
CORS_ORIGIN=http://localhost:5173
# Optional override; the server derives frontend/dist from its module location by default.
FRONTEND_DIST_DIR=

DATABASE_URL=postgres://user:password@localhost:5432/chalkboard
REDIS_URL=redis://localhost:6379

# Google Identity Services Web client ID
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# The first account matching this email is promoted to Super Admin after Google sign-in.
SUPER_ADMIN_EMAIL=you@example.com
# Use a random value with at least 32 characters.
AUTH_SESSION_SECRET=replace-with-a-long-random-session-secret

LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Plugin asset storage. Keep local while developing; switch to r2 after creating the bucket.
PLUGIN_STORAGE_MODE=local
PLUGIN_STORAGE_DIR=.data/plugin-storage
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=chalkboard-plugins-dev
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_SIGNED_URL_TTL_SECONDS=300

# Permanently close an open room after 24 hours without a join or canvas update.
ROOM_INACTIVITY_MS=86400000
# How often the worker scans for inactive rooms.
ROOM_CLEANUP_REPEAT_MS=3600000

# --- Rate limiting ---
# Number of reverse proxies (LB / ingress / CDN) in front of this process.
# MUST be set correctly in production: with 0 the X-Forwarded-For header is
# ignored entirely, and with too high a value clients can spoof their IP and
# bypass every limit. Set to 0 only when the app is directly internet-facing.
TRUSTED_PROXY_HOP_COUNT=0
# Only enable when Cloudflare is the edge proxy.
TRUST_CLOUDFLARE_HEADER=false
# Catch-all limiter applied to every /api request.
GLOBAL_RATE_LIMIT_MAX=300
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
# Google sign-in attempts per IP.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
# Admin TOTP verification attempts.
ADMIN_2FA_RATE_LIMIT_MAX=5
ADMIN_2FA_RATE_LIMIT_WINDOW_MS=300000
# Room join (password submission) and password reset.
ROOM_PASSWORD_RATE_LIMIT_MAX=10
ROOM_PASSWORD_RATE_LIMIT_WINDOW_MS=60000
# Plugin create / version upload / submit.
PLUGIN_WRITE_RATE_LIMIT_MAX=20
PLUGIN_WRITE_RATE_LIMIT_WINDOW_MS=60000
# Invite/room lookup and voice-token issuance.
INVITE_JOIN_RATE_LIMIT_MAX=20
INVITE_JOIN_RATE_LIMIT_WINDOW_MS=60000
# Realtime socket events.
CHAT_RATE_LIMIT_MAX=30
CHAT_RATE_LIMIT_WINDOW_MS=60000
REACTION_RATE_LIMIT_MAX=10
REACTION_RATE_LIMIT_WINDOW_MS=10000
HAND_RATE_LIMIT_MAX=6
HAND_RATE_LIMIT_WINDOW_MS=10000
# When Redis is unreachable, fall back to per-process counters (true) or reject
# requests outright (false). Fallback under-enforces across multiple replicas.
RATE_LIMIT_FALLBACK_TO_MEMORY=true
# Cap on fallback buckets held in memory.
RATE_LIMIT_MEMORY_MAX_KEYS=50000

# --- AI Agent (Chalkboard Master) ---
# URL of the autonomous agent microservice (Google ADK + Gemini).
AGENT_SERVICE_URL=http://localhost:8080
AGENT_SECRET=chalkboard_agent_internal_secret_key_2026
AGENT_RATE_LIMIT_MAX=10
AGENT_RATE_LIMIT_WINDOW_MS=60000

# --- Billing (Bachs) ---
# Leave BACHS_API_KEY empty to run with billing disabled: every user then
# resolves to the Free plan and the checkout routes return 503.
# BACHS_API_BASE_URL=https://sandbox-api.bachs.io
# BACHS_API_KEY=
# BACHS_WEBHOOK_SECRET=
# BACHS_PRODUCT_PRO_MONTHLY=
# BACHS_PRODUCT_PRO_ANNUAL=
# BACHS_PRODUCT_TEAM_MONTHLY=
# BACHS_PRODUCT_TEAM_ANNUAL=
# Per-seat add-on products for Team, sold with quantity = number of seats.
# BACHS_PRODUCT_TEAM_SEAT_MONTHLY=
# BACHS_PRODUCT_TEAM_SEAT_ANNUAL=
# Absolute, public origin used to build checkout success and cancel URLs.
# APP_PUBLIC_URL=http://localhost:5173
SENDBYTE_API_KEY=
# Sender for transactional emails; defaults to Chalkboard <notifications@chalkboard.click>.
# SENDBYTE_FROM_NAME=Chalkboard
# SENDBYTE_FROM_EMAIL=notifications@chalkboard.click
# The welcome email is sent personally: Chidi from Chalkboard <chidi@chalkboard.click>.
# SENDBYTE_WELCOME_FROM_NAME=Chidi from Chalkboard
# SENDBYTE_WELCOME_FROM_EMAIL=chidi@chalkboard.click
